<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>true</IsPackable>
        <PackageId>Okojo.RegExp.EcmaRegex</PackageId>
        <PackageVersion>$(OkojoPackageVersion_Okojo_RegExp_EcmaRegex)</PackageVersion>
        <Description>EcmaRegex-backed IRegExpEngine adapter for Okojo.</Description>
        <PackageTags>javascript;ecmascript;regexp;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Okojo\Okojo.csproj"/>
        <ProjectReference Include="..\..\EcmaRegex\src\EcmaRegex\EcmaRegex.csproj"/>
    </ItemGroup>
</Project>

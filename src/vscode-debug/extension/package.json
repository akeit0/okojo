{
  "name": "okojo-vscode-debug",
  "displayName": "Okojo Debugger",
  "description": "Source and bytecode debugging for the Okojo JavaScript engine, with a reusable stdio DAP adapter.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:okojo",
    "onCommand:okojo.showBytecode",
    "onCommand:okojo.debugOptions",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "configuration": {
      "title": "Okojo",
      "properties": {
        "okojo.debugger.openOnStop": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open the bytecode viewer when the active Okojo session stops."
        },
        "okojo.debugger.checkInterval": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "markdownDescription": "Checkpoint interval used for stepping and periodic execution checks during debug sessions."
        },
        "okojo.debugger.stepGranularity": {
          "type": "string",
          "enum": [
            "line",
            "instruction"
          ],
          "default": "line",
          "markdownDescription": "Default stepping granularity for the Okojo debugger."
        },
        "okojo.debugger.traceBreakpoints": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Emit runtime breakpoint patch and hit tracing from Okojo.DebugServer."
        },
        "okojo.debugger.traceAdapter": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Emit verbose VS Code adapter request and host-command tracing."
        },
        "okojo.debugger.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "Path to the .NET 10 dotnet executable."
        },
        "okojo.debugger.debugServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional published Okojo.DebugServer executable or DLL."
        }
      }
    },
    "commands": [
      {
        "command": "okojo.showBytecode",
        "title": "Okojo: Bytecode Viewer",
        "category": "Okojo"
      },
      {
        "command": "okojo.debugOptions",
        "title": "Okojo: Debugger Options",
        "category": "Okojo"
      }
    ],
    "debuggers": [
      {
        "type": "okojo",
        "label": "Okojo",
        "languages": [
          "javascript",
          "typescript"
        ],
        "program": "./dist/main.js",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "debugServerProject": {
                "type": "string",
                "description": "Path to the Okojo.DebugServer project file.",
                "default": "${workspaceFolder}/src/Okojo.DebugServer/Okojo.DebugServer.csproj"
              },
              "program": {
                "type": "string",
                "description": "Path to the JavaScript file to debug.",
                "default": "${workspaceFolder}/test.js"
              },
              "moduleEntry": {
                "type": "boolean",
                "description": "Treat the program as an ECMAScript module entry point.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debug target.",
                "default": "${workspaceFolder}"
              },
              "checkInterval": {
                "type": "number",
                "description": "Checkpoint interval used for step commands.",
                "default": 1024,
                "minimum": 1
              },
              "traceBreakpoints": {
                "type": "boolean",
                "description": "Emit runtime breakpoint patch tracing to stderr.",
                "default": false
              },
              "traceAdapter": {
                "type": "boolean",
                "description": "Emit verbose VS Code adapter request and host-command tracing.",
                "default": false
              },
              "enableSourceMaps": {
                "type": "boolean",
                "description": "Enable source-map remapping so authored TypeScript sources can be debugged through generated JavaScript.",
                "default": false
              },
              "stopOnDebuggerStatement": {
                "type": "boolean",
                "description": "Pause on debugger statements.",
                "default": true
              },
              "stopOnBreakpoint": {
                "type": "boolean",
                "description": "Pause on source breakpoints.",
                "default": true
              },
              "stopOnCall": {
                "type": "boolean",
                "description": "Pause on call checkpoints.",
                "default": false
              },
              "stopOnReturn": {
                "type": "boolean",
                "description": "Pause on return checkpoints.",
                "default": false
              },
              "stopOnPump": {
                "type": "boolean",
                "description": "Pause when the host pumps jobs.",
                "default": false
              },
              "stopOnSuspendGenerator": {
                "type": "boolean",
                "description": "Pause when a generator suspends.",
                "default": false
              },
              "stopOnResumeGenerator": {
                "type": "boolean",
                "description": "Pause when a generator resumes.",
                "default": false
              },
              "stopOnPeriodic": {
                "type": "boolean",
                "description": "Pause on periodic execution checks.",
                "default": false
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the pre-execution configuration barrier. Locals become available after execution starts.",
                "default": false
              },
              "debugServerPath": {
                "type": "string",
                "description": "Published Okojo.DebugServer executable or DLL. Takes precedence over debugServerProject."
              },
              "debugServerArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments preceding the standard flags when launching a published host."
              },
              "dotnetPath": {
                "type": "string",
                "default": "dotnet",
                "description": "dotnet executable used for .csproj or .dll hosts."
              },
              "noBuild": {
                "type": "boolean",
                "default": false,
                "description": "Use a previously built Release debug host when launching a project."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "Host environment overrides. null removes an inherited variable."
              },
              "startupTimeout": {
                "type": "integer",
                "minimum": 1,
                "default": 120000,
                "description": "Host startup/configuration-stop timeout in milliseconds."
              },
              "requestTimeout": {
                "type": "integer",
                "minimum": 1,
                "default": 10000,
                "description": "Host RPC timeout in milliseconds."
              },
              "stepGranularity": {
                "type": "string",
                "enum": [
                  "line",
                  "instruction"
                ],
                "default": "line",
                "description": "Default stepping granularity. DAP per-request granularity takes precedence."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Okojo: Launch",
            "type": "okojo",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "checkInterval": 1024,
            "enableSourceMaps": false,
            "stopOnDebuggerStatement": true,
            "stopOnBreakpoint": true,
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Okojo: Launch JavaScript",
            "description": "Debug a script or ES module using Okojo.",
            "body": {
              "type": "okojo",
              "request": "launch",
              "name": "Okojo: Launch",
              "program": "${workspaceFolder}/main.js",
              "cwd": "${workspaceFolder}",
              "stopOnEntry": true
            }
          }
        ],
        "runtime": "node"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile",
    "compile:adapter": "tsc -p tsconfig.adapter.json",
    "test": "npm run compile:adapter && node --test test/*.test.cjs",
    "test:engine": "npm run compile:adapter && node --test test/engine.e2e.cjs",
    "dap": "node dist/main.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.94.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akeit0/okojo"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Debugging launches local executable code."
    },
    "virtualWorkspaces": false
  },
  "bin": {
    "okojo-dap": "./dist/main.js"
  }
}
